# Database
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Authentication
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional - remove if not using)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# AWS Services
AWS_REGION_NEW="us-east-1"
AWS_ACCESS_KEY_ID_NEW=""
AWS_SECRET_ACCESS_KEY_NEW=""
S3_BUCKET_NAME_NEW=""
EMAIL_SENDER_ADDRESS="noreply@example.com"

# Canva API
BASE_CANVA_CONNECT_API_URL="https://api.canva.com"
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""

# Google AI
GOOGLE_GENERATIVE_AI_API_KEY=""

# Public URLs
NEXT_PUBLIC_FILE_STORAGE_HOST="https://storage.example.com"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=""

# Development
NODE_ENV="development"
NEXT_PUBLIC_MILLION_LINT_ENABLED="false"
